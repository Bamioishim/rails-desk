#!/usr/bin/env bash
# Mandatory Kane pre-push gate. Enable with `npm run hooks:install`.
# A missing CLI, missing credentials, skipped run, or failed report blocks the push.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! npm run kane:gate; then
  echo "" >&2
  echo "[pre-push] Kane gate did not PASS. Push blocked. Read KANE_REPORT.md, fix the issue, and rerun npm run kane:gate." >&2
  exit 1
fi
