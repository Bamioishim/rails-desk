# Rails Desk · X Layer / TapeOut settings. NEXT_PUBLIC_* values are browser-visible. Never put a private key here.

# Optional browser RPC overrides. Defaults: https://rpc.xlayer.tech (mainnet, TapeOut reads) and
# https://testrpc.xlayer.tech/terigon (testnet, wallet transactions).
NEXT_PUBLIC_XLAYER_RPC_URL=
NEXT_PUBLIC_XLAYER_TESTNET_RPC_URL=

# Server-only X Layer testnet RPC for settlement verification. Smart-account settlements require
# debug_traceTransaction with callTracer; the public default may block trace requests. Use a trace-enabled
# X Layer testnet endpoint here and keep any provider credentials server-side.
XLAYER_TESTNET_RPC_URL=

# Testnet ERC-20 to pay in (for example a faucet stablecoin on X Layer testnet). Leave empty to pay in test OKB.
NEXT_PUBLIC_XLAYER_TESTNET_TOKEN=
# When paying in test OKB: how much test OKB one demo dollar is worth. Default 0.0001.
NEXT_PUBLIC_DEMO_OKB_PER_USD=0.0001

# Wallets for the named demo payees. Configure a recipient distinct from the connected wallet for testnet settlement.
# Format: Alex=0x...,Jordan=0x...,Sam=0x...
NEXT_PUBLIC_DEMO_PAYEES=

# TapeOut identities on X Layer that are on the demo allowlist (comma separated, e.g. #1@2.254 or 1.2.254.tape).
NEXT_PUBLIC_TAPEOUT_ALLOWED=#1@2.254

# The taped-out policy circuit on X Layer mainnet. When both are set, every check is confirmed with eval() on chain.
NEXT_PUBLIC_TAPEOUT_POLICY_PROCESSOR=
NEXT_PUBLIC_TAPEOUT_POLICY_CIRCUIT_ID=

# Optional: Kane / LambdaTest browser tests (`npm run test:kane`).
# Get these from your LambdaTest dashboard. Never commit real values.
LT_USERNAME=
LT_ACCESS_KEY=
