# Rails Desk · X Layer / TapeOut settings. All values are public (NEXT_PUBLIC_*). Never put a private key here.

# Optional RPC overrides. Defaults: https://rpc.xlayer.tech (mainnet, TapeOut reads) and
# https://testrpc.xlayer.tech/terigon (testnet, transfers).
NEXT_PUBLIC_XLAYER_RPC_URL=
NEXT_PUBLIC_XLAYER_TESTNET_RPC_URL=

# Testnet ERC-20 to pay in (for example a faucet stablecoin on X Layer testnet). Leave empty to pay in test OKB.
NEXT_PUBLIC_XLAYER_TESTNET_TOKEN=
# When paying in test OKB: how much test OKB one demo dollar is worth. Default 0.0001.
NEXT_PUBLIC_DEMO_OKB_PER_USD=0.0001

# Wallets for the named demo payees. Names without an address pay the connected wallet (a self-transfer).
# Format: Alex=0x...,Jordan=0x...,Sam=0x...
NEXT_PUBLIC_DEMO_PAYEES=

# TapeOut identities on X Layer that are on the demo allowlist (comma separated, e.g. #1@2.254 or 1.2.254.tape).
NEXT_PUBLIC_TAPEOUT_ALLOWED=#1@2.254

# The taped-out policy circuit on X Layer mainnet. When both are set, every check is confirmed with eval() on chain.
NEXT_PUBLIC_TAPEOUT_POLICY_PROCESSOR=
NEXT_PUBLIC_TAPEOUT_POLICY_CIRCUIT_ID=
