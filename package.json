{
  "name": "rails-desk-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "receipts:verify": "node scripts/receipts.mjs verify",
    "receipts:append": "node scripts/receipts.mjs append",
    "circuit": "node scripts/policy-circuit.mjs",
    "typecheck": "tsc --noEmit",
    "test:kane": "bash scripts/run-kane-tests.sh",
    "kane:gate": "node scripts/kane-gate.mjs",
    "kane:gate:ci": "node scripts/kane-gate.mjs",
    "hooks:install": "git config core.hooksPath .githooks && echo 'Kane pre-push gate enabled (.githooks/pre-push)'",
    "hooks:uninstall": "git config --unset core.hooksPath || true",
    "verify:production": "node scripts/verify-production-redis.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.58.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
